# Public HTTP entry point: http://localhost:8080
HTTP_PORT=8080

# Published database ports are bound to localhost for local development.
CASSANDRA_PORT=9042
CASSANDRA_SECOND_PORT=9043
REDIS_PORT=6379
ELASTICSEARCH_PORT=9200

# Both Cassandra nodes must use the same cluster configuration.
CASSANDRA_CLUSTER_NAME=ws-chat
CASSANDRA_DC=datacenter1
CASSANDRA_RACK=rack1
CASSANDRA_MAX_HEAP_SIZE=512M
CASSANDRA_HEAP_NEWSIZE=100M

ELASTICSEARCH_VERSION=9.5.6
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
