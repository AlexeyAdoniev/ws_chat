{
  "name": "ws-chat",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "yarn build && node dist/test.js",
    "dev": "node --watch --watch-path=src --watch-preserve-output -e \"require('node:child_process').execSync('yarn build', { stdio: 'inherit' }); require('./dist/main.js');\""
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/platform-ws": "^11",
    "@nestjs/websockets": "^11",
    "cassandra-driver": "^4.10.0",
    "ioredis": "^5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/ws": "^8",
    "typescript": "^5"
  }
}
